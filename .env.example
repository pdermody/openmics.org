NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgres://openmic:openmic_local@127.0.0.1:5432/openmic_dev
SIMULATED_AUTH_MODE=false
# Email adapter: "console" (default in dev, logs to stdout), "memory" (default in test), or "ses" (production; enqueues to EMAIL_QUEUE_URL)
EMAIL_ADAPTER=console
EMAIL_QUEUE_URL=
EMAIL_SENDER_ADDRESS=noreply@openmics.org
AWS_REGION=eu-west-1
# Cognito user pool + app client used to verify ID tokens. Leave both blank in dev/test to use
# the interim cognito_id-as-bearer-token verifier instead of real Cognito JWT verification.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Base URL the API uses to build frontend links (e.g. registration confirm/edit links) in emails
APP_BASE_URL=http://localhost:5173
# LocationIQ API key used server-side by the /geocoding proxy (forward/reverse address lookups for the map picker).
# Get a free-tier key at https://locationiq.com. Leave blank in dev/test to disable geocoding assist.
LOCATIONIQ_API_KEY=
LOCATIONIQ_BASE_URL=https://us1.locationiq.com

# Media storage. Default "local" (in-memory fake) needs nothing else but cannot accept real
# browser PUTs. To test real photo uploads locally, switch to "s3" and start LocalStack
# (`docker compose up -d localstack` — bucket/CORS/queue auto-provisioned by
# scripts/localstack/init-media.sh). AWS_ENDPOINT_URL_S3/SQS are consumed directly by the
# AWS SDK (not by app config). The S3 endpoint MUST use the `s3.` subdomain: LocalStack only
# routes virtual-hosted presigned URLs on `<bucket>.s3.localhost.localstack.cloud` (the
# *.localhost.localstack.cloud wildcard DNS resolves to 127.0.0.1, so this works from the
# browser without hosts-file edits). MEDIA_CDN_BASE_URL stays path-style for unsigned GETs.
# Leave all of these blank/unset with the local adapter.
MEDIA_STORAGE_ADAPTER=local
MEDIA_BUCKET=openmic-media-local
MEDIA_CDN_BASE_URL=http://localhost.localstack.cloud:4566/openmic-media-local
MEDIA_RENDITIONS_QUEUE_URL=http://localhost.localstack.cloud:4566/000000000000/openmic-media-renditions-local
AWS_ENDPOINT_URL_S3=http://s3.localhost.localstack.cloud:4566
AWS_ENDPOINT_URL_SQS=http://localhost.localstack.cloud:4566
# LocalStack accepts any credentials; the SDK just requires them to be non-empty.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test