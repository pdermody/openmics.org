NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgres://openmic:openmic_local@127.0.0.1:5432/openmic_dev
SIMULATED_AUTH_MODE=false
# Email adapter: "console" (default in dev, logs to stdout), "memory" (default in test), or "ses" (production; enqueues to EMAIL_QUEUE_URL)
EMAIL_ADAPTER=console
EMAIL_QUEUE_URL=
EMAIL_SENDER_ADDRESS=noreply@openmics.org
AWS_REGION=eu-west-1
# Cognito user pool + app client used to verify ID tokens. Leave both blank in dev/test to use
# the interim cognito_id-as-bearer-token verifier instead of real Cognito JWT verification.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Base URL the API uses to build frontend links (e.g. registration confirm/edit links) in emails
APP_BASE_URL=http://localhost:5173
# LocationIQ API key used server-side by the /geocoding proxy (forward/reverse address lookups for the map picker).
# Get a free-tier key at https://locationiq.com. Leave blank in dev/test to disable geocoding assist.
LOCATIONIQ_API_KEY=
LOCATIONIQ_BASE_URL=https://us1.locationiq.com