{
  "name": "openmic",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:api": "tsc -p tsconfig.json",
    "db:migrate": "node --env-file=.env node_modules/node-pg-migrate/bin/node-pg-migrate.js up -m apps/api/migrations",
    "db:migrate:e2e": "node --env-file=.env --env-file=.env.e2e node_modules/node-pg-migrate/bin/node-pg-migrate.js up -m apps/api/migrations",
    "db:migrate:prod": "node scripts/migrate-prod.mjs",
    "db:rollback": "node --env-file=.env node_modules/node-pg-migrate/bin/node-pg-migrate.js down -m apps/api/migrations",
    "db:seed:dev": "node --env-file=.env scripts/seed-dev.mjs",
    "db:seed:e2e": "node --env-file=.env --env-file=.env.e2e scripts/seed-dev.mjs",
    "db:reset:e2e": "npm run db:migrate:e2e && npm run db:seed:e2e",
    "dev:api": "tsx watch --env-file=.env apps/api/src/server.ts",
    "dev:api:e2e": "tsx watch --env-file=.env --env-file=.env.e2e apps/api/src/server.ts",
    "dev:web": "npm --prefix apps/web run dev",
    "start:api": "node dist/apps/api/src/server.js",
    "build:web": "npm run build --prefix apps/web",
    "test:web": "npm run test --prefix apps/web",
    "typecheck:api": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run apps/api/tests/unit --exclude 'infra/**'",
    "test:api": "vitest run apps/api/tests/api --exclude 'infra/**'",
    "test:integration": "vitest run apps/api/tests/integration --exclude 'infra/**'",
    "test:lambda": "vitest run infra/lib/lambda --exclude 'infra/cdk.out/**'",
    "test": "npm run typecheck:api && npm run test:unit && npm run test:api && npm run test:integration && npm run test:lambda && npm run test:web",
    "validate:openapi": "node scripts/validate-openapi.mjs",
    "coverage:openapi": "node scripts/openapi-coverage.mjs",
    "lint:openapi": "spectral lint openapi.yaml --ruleset spectral.yaml",
    "format:openapi": "prettier --write openapi.yaml",
    "check:links": "node scripts/check-links.mjs",
    "check": "npm run validate:openapi && npm run lint:openapi"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "description": "",
  "devDependencies": {
    "@apidevtools/swagger-parser": "12.1.0",
    "@stoplight/spectral-cli": "6.13.1",
    "@testcontainers/postgresql": "^11.0.0",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "markdown-link-check": "3.10.2",
    "node-pg-migrate": "^8.0.3",
    "prettier": "3.6.2",
    "testcontainers": "^11.0.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "yaml": "2.9.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1145.0",
    "@aws-sdk/client-sqs": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1145.0",
    "fastify": "^5.6.1",
    "jose": "^6.2.12",
    "pg": "^8.16.3",
    "zod": "^4.1.5"
  }
}
