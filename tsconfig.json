{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "sourceMap": true,
    "noEmitOnError": true
  },
  "include": ["apps/api/src/**/*.ts", "apps/api/tests/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}